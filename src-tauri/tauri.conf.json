{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "osu-chokelens",
  "version": "0.1.0",
  "identifier": "com.chokelens.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {

    "windows": [
      {
        "label": "main",
        "title": "osu! ChokeLens",
        "width": 480,
        "height": 360,
        "resizable": true,
        "minWidth": 320,
        "minHeight": 220,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
